{
  "name": "telecom-demo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "concurrently \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "next dev",
    "dev:backend": "node scripts/run-backend.mjs bootRun",
    "build": "next build",
    "build:backend": "node scripts/run-backend.mjs build",
    "start": "concurrently \"pnpm start:frontend\" \"pnpm start:backend\"",
    "start:frontend": "next start",
    "start:backend": "node scripts/run-backend.mjs jar",
    "test": "pnpm test:frontend && pnpm test:backend",
    "test:frontend": "vitest run",
    "test:frontend:coverage": "vitest run --coverage",
    "test:backend": "node scripts/run-backend.mjs test",
    "test:backend:coverage": "node scripts/run-backend.mjs test jacocoTestReport",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . && tsc --noEmit",
    "lint:backend": "node scripts/run-backend.mjs lint",
    "lint:all": "pnpm lint && pnpm lint:backend",
    "check:dup": "jscpd .",
    "check:deps": "knip --include files,dependencies",
    "format": "prettier --write . && node scripts/run-backend.mjs format",
    "format:check": "prettier --check . && node scripts/run-backend.mjs formatCheck",
    "format:frontend": "prettier --write .",
    "format:backend": "node scripts/run-backend.mjs format",
    "setup": "pnpm install --frozen-lockfile && pnpm setup:db",
    "setup:db": "node scripts/seed-db.mjs",
    "reset:db": "node scripts/reset-db.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "2.15.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "jscpd": "^5.3.2",
    "jsdom": "^30.0.1",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "unrs-resolver"
    ]
  }
}
