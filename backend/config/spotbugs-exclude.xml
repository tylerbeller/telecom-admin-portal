<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Exclude Spring Boot generated classes -->
    <Match>
        <Class name="~com\.example\.telecom\.TelecomDemoApplication\$\$.*"/>
    </Match>

    <!-- Exclude test classes from security checks -->
    <Match>
        <Source name="~.*Test\.java"/>
        <Bug category="SECURITY"/>
    </Match>

    <!-- Exclude JPA entity equals/hashCode warnings (intentional design) -->
    <Match>
        <Package name="com.example.telecom.model"/>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
    </Match>

    <!-- Exclude false positives for Spring Data repositories -->
    <Match>
        <Package name="com.example.telecom.repository"/>
        <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
    </Match>

    <!-- JPA relations and immutable response records intentionally return associated objects. -->
    <Match>
        <Package name="com.example.telecom.model"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="~com\.example\.telecom\.controller\.(SupportTicketController|UsageRecordController)\$PagedResponse"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Controller path IDs are numeric; SpotBugs treats all request parameters as CRLF-capable strings. -->
    <Match>
        <Package name="com.example.telecom.controller"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- Allow Spring's @Autowired injection patterns -->
    <Match>
        <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
        <Or>
            <Annotation name="org.springframework.beans.factory.annotation.Autowired"/>
            <Annotation name="jakarta.inject.Inject"/>
        </Or>
    </Match>
</FindBugsFilter>
